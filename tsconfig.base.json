{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],

    // Imports are extensionless and lean on directory `index` resolution
    // (`@core/domain`, never `@core/domain/index.ts`). Only `bundler` above
    // makes that legal, and every consumer here is one: nothing emits JS, each
    // package is loaded as source by Vite/esbuild.

    // Package-qualified aliases, declared centrally so they resolve identically
    // from every package. A bare `@/*` cannot work here: when one package
    // consumes another's SOURCE, `@` would resolve against the consumer.
    // Paths are relative to THIS file (TypeScript 7 removed `baseUrl`).
    "paths": {
      "@core/*": ["./packages/core/src/*"],
      "@mime/*": ["./packages/mime/src/*"],
      "@shared/*": ["./packages/shared/src/*"],
      "@web/*": ["./apps/web/*"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  }
}
