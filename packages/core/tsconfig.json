{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "noEmit": true,
    // TypeScript 7 removed `baseUrl`; `paths` resolve relative to this file.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
