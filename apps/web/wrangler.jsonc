{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailworker",
  "main": "workers/entry.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // One Worker is the whole deployment (ADR-6): SSR, the /v1 API, the inbound
  // email() handler and the queue consumers. One `wrangler deploy`, one URL,
  // one origin for the CLI, the SDK and the dashboard alike.
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailworker",
      "database_id": "PLACEHOLDER_RUN_MAILWORKER_DEPLOY",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      // Raw MIME, attachments and pending outbound payloads (ADR-3). Keeping
      // every original message is what makes `get --raw` into `inject` a closed
      // testing loop and lets a parser change be replayed over real mail.
      "binding": "BLOBS",
      "bucket_name": "mailworker-blobs"
    }
  ],

  // Sending needs Workers Paid and a verified domain, so this is the one
  // binding a working deployment can legitimately lack — receiving is free and
  // stays functional without it. The container degrades to a transport that
  // records a clear failure rather than refusing to boot.
  "send_email": [{ "name": "SEND_EMAIL" }],

  "queues": {
    "producers": [
      {
        // Ours. `send` ends at `queued` with the decision and payload already
        // durable; the consumer does the network call. Splitting there is what
        // makes a failed send a retry against a recorded decision rather than a
        // re-run of the policy gates.
        "binding": "DISPATCH_QUEUE",
        "queue": "mailworker-dispatch"
      }
    ],
    "consumers": [
      {
        "queue": "mailworker-dispatch",
        // Small batches and few retries: each message is one send, and a send
        // that has failed three times is failing for a reason another attempt
        // will not change. The DLQ is where a human looks, not a slower retry.
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "mailworker-dispatch-dlq"
      },
      {
        // Cloudflare's: the six cf.email.sending.message.* types from the event
        // subscription on the sending domain (DESIGN §2.3). Bigger batches,
        // because each one is an append and a state transition, and more
        // retries, because losing a bounce means losing a suppression.
        "queue": "mailworker-events",
        "max_batch_size": 100,
        "max_retries": 5,
        "dead_letter_queue": "mailworker-events-dlq"
      }
    ]
  },

  "durable_objects": {
    "bindings": [
      {
        // Where `wait` blocks. One instance per account, addressed by name, so
        // the ingest path has somewhere to deliver a notification the moment a
        // message is stored. The alternative — polling D1 — would load the
        // database in proportion to the number of idle waiters and add latency
        // to the one operation whose whole value is being fast.
        "name": "WAITER",
        "class_name": "MessageWaiter"
      }
    ]
  },

  "migrations": [
    {
      // `new_classes`, not `new_sqlite_classes`: the waiter persists nothing.
      // A waiter is a caller holding an open request, and one that outlived its
      // own request would be waiting for nobody.
      "tag": "v1",
      "new_classes": ["MessageWaiter"]
    }
  ],

  "vars": {
    "MAILWORKER_ACCOUNT_ID": "default"
  }

  // Secrets, set by `mailworker deploy` rather than declared here:
  //   MAILWORKER_ADMIN_KEY — the bootstrap credential. A fresh deployment has
  //     an empty api_keys table and no way to fill it; this breaks the cycle,
  //     and `mailworker keys create` uses it once to mint a real scoped key.
}
