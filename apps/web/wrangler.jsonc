{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailworker",
  "main": "workers/entry.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // One Worker is the whole deployment: SSR, the /v1 API, the inbound
  // email() handler and the queue consumers. One `wrangler deploy`, one URL,
  // one origin for the CLI, the SDK and the dashboard alike.
  "observability": { "enabled": true },

  // The dashboard's client bundle, built by Vite. Static files are served
  // straight off Cloudflare's edge and never reach the Worker, which is what
  // keeps a page load from costing a request against a Worker that is also
  // handling inbound mail.
  "assets": { "directory": "./build/client" },

  // A stable origin for the CLI, the SDK and bookmarks, instead of the
  // workers.dev name that changes if the Worker is ever renamed. Cloudflare
  // provisions the proxied hostname record itself; it is orthogonal to MX, so
  // this shares nextdevkit.com with Lark's mailboxes without touching them.
  "routes": [{ "pattern": "mailworker.nextdevkit.com", "custom_domain": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailworker",
      "database_id": "24ed88fc-b204-4dbb-b776-f689a4166457",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      // Raw MIME, attachments and pending outbound payloads. Keeping
      // every original message is what makes `get --raw` into `inject` a closed
      // testing loop and lets a parser change be replayed over real mail.
      "binding": "BLOBS",
      "bucket_name": "mailworker-blobs"
    }
  ],

  // Sending needs Workers Paid and a verified domain, so this is the one
  // binding a working deployment can legitimately lack — receiving is free and
  // stays functional without it. The container degrades to a transport that
  // records a clear failure rather than refusing to boot.
  "send_email": [{ "name": "SEND_EMAIL" }],

  "queues": {
    "producers": [
      {
        // Ours. `send` ends at `queued` with the decision and payload already
        // durable; the consumer does the network call. Splitting there is what
        // makes a failed send a retry against a recorded decision rather than a
        // re-run of the policy gates.
        "binding": "DISPATCH_QUEUE",
        "queue": "mailworker-dispatch"
      },
      {
        // Domain events, fanned out to webhook subscribers. A separate queue
        // from dispatch because the failure modes are unrelated: a subscriber
        // being down must not delay anyone's mail.
        "binding": "WEBHOOK_QUEUE",
        "queue": "mailworker-webhooks"
      }
    ],
    "consumers": [
      {
        "queue": "mailworker-dispatch",
        // Small batches and few retries: each message is one send, and a send
        // that has failed three times is failing for a reason another attempt
        // will not change. The DLQ is where a human looks, not a slower retry.
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "mailworker-dispatch-dlq"
      },
      {
        // Cloudflare's: the six cf.email.sending.message.* types from the event
        // subscription on the sending domain (DESIGN §2.3). Bigger batches,
        // because each one is an append and a state transition, and more
        // retries, because losing a bounce means losing a suppression.
        "queue": "mailworker-events",
        "max_batch_size": 100,
        "max_retries": 5,
        "dead_letter_queue": "mailworker-events-dlq"
      },
      {
        // Webhook fan-out. The most retries of the three, because the usual
        // failure is someone else's deploy: a subscriber down for two minutes
        // should not cost them the events, and Cloudflare owns the backoff.
        "queue": "mailworker-webhooks",
        "max_batch_size": 10,
        "max_retries": 8,
        "dead_letter_queue": "mailworker-webhooks-dlq"
      }
    ]
  },

  // Retention. Nothing else in the deployment deletes an expired inbox, so
  // without this an ephemeral inbox is only ephemeral in the sense that it stops
  // answering — the rows and the R2 objects stay forever.
  //
  // Hourly, not per-minute: the grace period is 24h (RetentionPolicy), so the
  // sweep is never racing anything, and each run is capped at 200 inboxes.
  // An hour of drift on erasing something that expired a day ago costs nothing;
  // a per-minute cron on an account with no expiries costs 1,440 invocations
  // a day to log a zero.
  "triggers": { "crons": ["0 * * * *"] },

  "durable_objects": {
    "bindings": [
      {
        // Where `wait` blocks. One instance per account, addressed by name, so
        // the ingest path has somewhere to deliver a notification the moment a
        // message is stored. The alternative — polling D1 — would load the
        // database in proportion to the number of idle waiters and add latency
        // to the one operation whose whole value is being fast.
        "name": "WAITER",
        "class_name": "MessageWaiter"
      }
    ]
  },

  "migrations": [
    {
      // The backend is immaterial here — the waiter persists nothing, because a
      // waiter is a caller holding an open request and one that outlived its own
      // request would be waiting for nobody. So this takes the only backend
      // Cloudflare still hands out: new key-value-backed namespaces are no
      // longer created for accounts without an existing one, and `new_classes`
      // fails the deploy outright.
      "tag": "v1",
      "new_sqlite_classes": ["MessageWaiter"]
    }
  ],

  "vars": {
    // The environment a request lands in when nothing names another, and the
    // project whose environments an admin credential may switch between. An
    // environment IS an account, so this is the production one.
    "MAILWORKER_ACCOUNT_ID": "default",
    "MAILWORKER_PROJECT_ID": "default"
  }

  // Secrets, set by `mailworker deploy` rather than declared here:
  //   MAILWORKER_ADMIN_KEY — the bootstrap credential. A fresh deployment has
  //     an empty api_keys table and no way to fill it; this breaks the cycle,
  //     and `mailworker keys create` uses it once to mint a real scoped key.
}
