{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The only package that knows what a Worker is, and it learns it from
    // `worker-configuration.d.ts` — generated by `wrangler types` out of
    // wrangler.jsonc, so `Env` names the bindings this deployment actually has
    // and the runtime types match the workerd we run against. Rerun
    // `pnpm cf-typegen` after touching wrangler.jsonc.
    //
    // Node's globals are deliberately absent: `setTimeout` returns a number
    // here, not a NodeJS.Timeout, and pretending otherwise is how a build passes
    // and a deploy does not. The Node-side config files are checked by
    // tsconfig.node.json instead.
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "lib": ["ES2023"],
    "noEmit": true
  },
  "include": ["workers/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
