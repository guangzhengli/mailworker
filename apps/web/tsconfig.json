{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The only package that knows what a Worker is, and it learns it from
    // `worker-configuration.d.ts` — generated by `wrangler types` out of
    // wrangler.jsonc, so `Env` names the bindings this deployment actually has
    // and the runtime types match the workerd we run against. Rerun
    // `pnpm cf-typegen` after touching wrangler.jsonc.
    //
    // Node's globals are deliberately absent: `setTimeout` returns a number
    // here, not a NodeJS.Timeout, and pretending otherwise is how a build passes
    // and a deploy does not. The Node-side config files are checked by
    // tsconfig.node.json instead.
    "types": ["@cloudflare/vitest-pool-workers/types", "vite/client"],

    // DOM alongside the Worker types, because `app/` runs in both places: React
    // Router renders the same route module on the server and hydrates it in the
    // browser. One project rather than two, because the boundary is not a
    // directory — `workers/render.ts` imports `app/context.ts` and every loader
    // imports the container — so a split would leave each project unable to
    // resolve half of the other's imports.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    // `react-router typegen` writes per-route types (`./+types/<route>`) into
    // `.react-router/types`, mirroring the app directory. `rootDirs` is what
    // makes those relative specifiers resolve from the route file's own
    // location — without it every `import type { Route }` is an error.
    "rootDirs": [".", "./.react-router/types"],

    "noEmit": true
  },
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "workers/**/*.ts",
    "test/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
