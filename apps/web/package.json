{
  "name": "@mailworker/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The deployable Worker: Cloudflare adapters for the core ports, the HTTP API, the email handler, the queue consumers and the dashboard.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mailworker --local",
    "db:migrate": "wrangler d1 migrations apply mailworker --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@mailworker/contract": "workspace:*",
    "@mailworker/core": "workspace:*",
    "@mailworker/mime": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "ulid": "^3.0.2",
    "isbot": "^5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
